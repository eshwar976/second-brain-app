VAULT_PATH=/Users/vamshi/Documents/obsidian/obsidian-personal
HOST=127.0.0.1
PORT=3030
WATCH_DEBOUNCE_MS=1200
# Used automatically for iCloud/CloudDocs vault paths to avoid rebuild storms while files hydrate.
ICLOUD_WATCH_DEBOUNCE_MS=15000
ICLOUD_STARTUP_INDEX_DELAY_MS=30000
ICLOUD_READ_RETRY_COUNT=3
MAX_INDEX_READ_ERROR_LOGS=10
AUTO_INDEX_ON_START=true
# For iCloud live vaults, prefer no continuous watcher and a nightly rebuild.
VAULT_WATCH_ENABLED=false
NIGHTLY_INDEX_ENABLED=true
NIGHTLY_INDEX_HOUR=3
NIGHTLY_INDEX_MINUTE=15
APP_SECRET=
# Host-aware auth:
# - secondbrain.vamshisasi.com uses GitHub OAuth
# - local/private IPs use APP_SECRET
GITHUB_AUTH_HOSTS=secondbrain.vamshisasi.com
APP_SECRET_AUTH_HOSTS=127.0.0.1,localhost,192.168.68.5
# MCP server. Disabled by default; set MCP_ENABLED=true only with a strong MCP_TOKEN.
MCP_ENABLED=false
MCP_HOST=0.0.0.0
MCP_PORT=3031
MCP_TOKEN=
MCP_ALLOWED_TOOLS=capture.append,capture.recent,tasks.create,tasks.list,sprint.current,sprint.set_daily_focus,dashboard.summary
# Optional per-client narrowing. Client names come from X-MCP-Client or X-Client-Name.
# Format: "client-a:tool.one|tool.two;client-b:tool.three"
MCP_CLIENT_TOOL_ALLOWLISTS=
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=60
MCP_AUDIT_LOG=.data/mcp-audit.jsonl
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
GITHUB_ALLOWED_LOGINS=
SESSION_MAX_AGE=86400
INDEX_IGNORE=
INDEX_IGNORE_FILE=.second-brain-ignore
CHAT_PROVIDER=hermes
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_AUTO_START=true
HERMES_HOST=127.0.0.1
HERMES_PORT=8642
HERMES_BIN=
HERMES_REGULAR_MODEL=deepseek-v4-flash
HERMES_THINKING_MODEL=deepseek-v4-pro
HERMES_REQUEST_TIMEOUT_MS=120000
HERMES_CHAT_TIMEOUT_MS=180000
HERMES_CHAT_SLOW_LOG_MS=30000
HERMES_WORKFLOW_TIMEOUT_MS=900000
CHAT_SELECTED_CONTEXT_ENTRY_LIMIT=16000
# Pre-read critical Markdown files before starting Hermes when the vault lives in iCloud.
HYDRATE_VAULT_ON_START=true
HYDRATE_VAULT_PATHS=
DEEPSEEK_API_KEY=
DEEPSEEK_REGULAR_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TRAINING_OPT_OUT=true
CHAT_CONTEXT_LIMIT=6
CHAT_HISTORY_LIMIT=8
CHAT_SESSIONS_DIR=3.Resources/gpt/sessions
DEEP_WORK_SESSIONS_DIR=3.Resources/gpt/sessions/deep-work
CHAT_NOTES_DIR=3.Resources/gpt/notes
FLEETING_REVIEWS_DIR=3.Resources/gpt/reviews/fleeting
AUTOMATION_LOG_DIR=3.Resources/gpt/automation-log
PERSONAL_OKR_ROOT=2.Areas/Personal/OKRs
PERSONAL_IDEA_LEDGER_PATH=2.Areas/Personal/Ideas/idea-ledger.md
# Optional override. Leave blank to dynamically select the active sprint-state file by date.
PERSONAL_SPRINT_STATE_PATH=
